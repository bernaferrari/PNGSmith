<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleName</key><string>PNG Smith</string>
    <key>CFBundleDisplayName</key><string>PNG Smith</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <key>CFBundleDocumentTypes</key><array>
        <dict>
            <key>CFBundleTypeName</key><string>PNG Image</string>
            <key>CFBundleTypeRole</key><string>Editor</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.png</string></array>
        </dict>
    </array>
    <key>PNGSmithAppGroup</key><string>$(DEVELOPMENT_TEAM).com.bernardoferrari.pngsmith</string>
    <key>NSHumanReadableCopyright</key><string>Copyright © 2026 PNG Smith contributors</string>
    <key>SUFeedURL</key><string>$(PNGSMITH_UPDATE_FEED_URL)</string>
    <key>SUPublicEDKey</key><string>$(PNGSMITH_SPARKLE_PUBLIC_KEY)</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>NSServices</key><array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>PNG Smith — Compress</string></dict>
            <key>NSMessage</key><string>compressPNG</string>
            <key>NSPortName</key><string>PNGSmith</string>
            <key>NSSendFileTypes</key><array><string>public.png</string></array>
            <key>NSUserData</key><string>compress</string>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>PNG Smith — Reduce to 256 Colors</string></dict>
            <key>NSMessage</key><string>compressPNG</string>
            <key>NSPortName</key><string>PNGSmith</string>
            <key>NSSendFileTypes</key><array><string>public.png</string></array>
            <key>NSUserData</key><string>reduce-256</string>
        </dict>
    </array>
</dict></plist>
